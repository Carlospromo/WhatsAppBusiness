{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": "./dist/worker",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve"
  },
  "include": ["worker.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", "tests"]
}
