# Local development: PostgreSQL exposed by docker-compose.dev.yml
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://whatsapp:whatsapp@localhost:5432/whatsappbusiness?schema=public"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"
INITIAL_ADMIN_NAME="Administrador"
NODE_ENV="development"

# WhatsApp Web profile storage. Railway must mount the single volume at /data.
WA_WEB_AUTH_DIR="/data/wwebjs-auth"
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
# Railway does not allow Chromium's namespace sandbox. Keep false locally unless required.
PUPPETEER_NO_SANDBOX="false"
WA_WEB_CLIENT_READY_TIMEOUT_SECONDS="120"
# Espera antes del sondeo de compatibilidad: whatsapp-web.js inicializa sus
# APIs de chats después de emitir `authenticated`.
WA_WEB_READY_PROBE_DELAY_SECONDS="25"
WA_ACCOUNT_CHECK_SECONDS="15"
# Reconciliación acotada de entradas mediante APIs públicas del cliente web.
# Solo revisa chats cuya actividad cambió tras la conexión; no importa historial completo.
WA_WEB_INBOUND_RECONCILE_SECONDS="30"
WA_WEB_INBOUND_RECONCILE_LIMIT="25"
LOG_LEVEL="info"

# Preventive limits for explicit manual messages only.
WA_OUTBOUND_MAX_PENDING="20"
WA_OUTBOUND_MAX_PER_MINUTE="6"
WA_OUTBOUND_MIN_INTERVAL_SECONDS="5"
WA_OUTBOUND_MAX_NEW_CHATS_PER_DAY="10"

# Private Cloudflare R2 media storage. Do not enable r2.dev or a public domain.
MEDIA_STORAGE="r2"
R2_BUCKET="whatsimages"
R2_ACCOUNT_ID=""
R2_ENDPOINT="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# whatsapp-web.js downloads Base64: keep memory-safe limits.
WA_WEB_MAX_MEDIA_BYTES="26214400"
WA_WEB_MAX_IMAGE_BYTES="10485760"
WA_WEB_MAX_AUDIO_BYTES="20971520"
WA_WEB_MAX_VIDEO_BYTES="26214400"
