# Local development: file:./dev.db
# Railway: file:/data/app.db
DATABASE_URL="file:./dev.db"

# Use at least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Used only to create the first administrator when no users exist.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"
INITIAL_ADMIN_NAME="Administrador"

NODE_ENV="development"
