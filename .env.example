# Local development: PostgreSQL exposed by docker-compose.dev.yml
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://whatsapp:whatsapp@localhost:5432/whatsappbusiness?schema=public"

# Use at least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Used only to create the first administrator when no users exist.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"
INITIAL_ADMIN_NAME="Administrador"

NODE_ENV="development"

# Bridge de WhatsApp: en Railway debe estar dentro del volumen /data.
WA_AUTH_DIR="./auth_store"
LOG_LEVEL="info"
# Default mode: keep the linked socket connected for reliable real-time receipt,
# while presence remains unavailable outside explicit message processing.
WA_CONNECTION_MODE="continuous"
# Used only when WA_CONNECTION_MODE="periodic". Periodic mode cannot guarantee
# receipt of messages that WhatsApp does not replay after a disconnected window.
WA_SYNC_INTERVAL_SECONDS="300"
WA_SYNC_WINDOW_SECONDS="45"
WA_SYNC_CONNECT_TIMEOUT_SECONDS="45"
WA_ACCOUNT_CHECK_SECONDS="15"
WA_LINK_WINDOW_SECONDS="120"

# Private Cloudflare R2 media storage. Keep the bucket private; do not enable r2.dev.
MEDIA_STORAGE="r2"
R2_BUCKET="whatsimages"
R2_ACCOUNT_ID=""
R2_ENDPOINT="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Generate with: openssl rand -base64 32
MEDIA_ENCRYPTION_KEY=""
MEDIA_MAX_IMAGE_BYTES="20971520"
MEDIA_MAX_AUDIO_BYTES="52428800"
MEDIA_MAX_VIDEO_BYTES="262144000"
