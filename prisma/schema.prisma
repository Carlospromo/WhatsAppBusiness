generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  VIEWER
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  WAITING_FOR_QR
  CONNECTING
  CONNECTED
  ERROR
}

enum WhatsAppBridgeType {
  BAILEYS_LEGACY
  WWEBJS
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum OutboundMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELED
}

enum ReadReceiptStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum HistoryRecoveryStatus {
  PENDING
  WAITING
  COMPLETED
  FAILED
}

enum MediaAttachmentKind {
  IMAGE
  AUDIO
  VIDEO
}

enum MediaAttachmentStatus {
  PENDING
  DOWNLOADING
  STORED
  RETRYING
  FAILED
  REJECTED_LIMIT
  UNAVAILABLE
}

enum AddressBookContactOrigin {
  IMPORTED
  WHATSAPP_SYNC
  EXTERNAL
  MANUAL
}

enum AddressBookContactStatus {
  VERIFIED
  EXTERNAL
}

enum ContactImportStatus {
  DRAFT
  PREVIEWED
  APPLIED
  FAILED
}

enum ContactImportItemAction {
  CREATE
  UPDATE
  SKIP
  ERROR
}

model User {
  id                      String                      @id @default(cuid())
  email                   String                      @unique
  name                    String
  passwordHash            String
  role                    Role                        @default(AGENT)
  isActive                Boolean                     @default(true)
  sessions                Session[]
  auditLogs               AuditLog[]
  outboundRequests        OutboundMessageRequest[]
  readReceiptRequests     ReadReceiptRequest[]
  historyRecoveryRequests HistoryRecoveryRequest[]
  assignedConversations   Conversation[]              @relation("ConversationAssignee")
  notes                   ConversationNote[]
  accountMemberships      WhatsAppAccountMembership[]
  createdAccounts         WhatsAppAccount[]           @relation("AccountCreator")
  contactImports          ContactImport[]
  addressBookContacts     AddressBookContact[]        @relation("AddressBookCreator")
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WhatsAppAccount {
  id                             String                         @id @default(cuid())
  name                           String
  slug                           String                         @unique
  isActive                       Boolean                        @default(true)
  defaultPhoneCountry            String                         @default("ES")
  createdById                    String?
  createdBy                      User?                          @relation("AccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  connection                     WhatsAppConnection?
  contacts                       Contact[]
  conversations                  Conversation[]
  conversationExternalIdentities ConversationExternalIdentity[]
  messages                       Message[]
  mediaAttachments               MediaAttachment[]
  outboundRequests               OutboundMessageRequest[]
  readReceiptRequests            ReadReceiptRequest[]
  historyRecoveryRequests        HistoryRecoveryRequest[]
  tags                           ConversationTag[]
  memberships                    WhatsAppAccountMembership[]
  auditLogs                      AuditLog[]
  addressBookContacts            AddressBookContact[]
  addressBookPhones              AddressBookPhone[]
  contactImports                 ContactImport[]
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt

  @@index([isActive])
}

model WhatsAppAccountMembership {
  accountId String
  userId    String
  createdAt DateTime        @default(now())
  account   WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([accountId, userId])
  @@index([userId])
}

model WhatsAppConnection {
  id                  String                   @id @default(cuid())
  accountId           String                   @unique
  status              WhatsAppConnectionStatus @default(DISCONNECTED)
  bridgeType          WhatsAppBridgeType       @default(WWEBJS)
  qrCode              String?
  qrExpiresAt         DateTime?
  accountJid          String?
  maskedPhone         String?
  lastError           String?
  relinkRequestId     String?
  outboundPausedAt    DateTime?
  outboundPauseEndsAt DateTime?
  outboundPauseReason String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  account             WhatsAppAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Contact {
  id                      String              @id @default(cuid())
  accountId               String
  jid                     String
  phone                   String?
  displayName             String?
  pushName                String?
  profilePictureUrl       String?
  profilePictureUpdatedAt DateTime?
  addressBookContactId    String?
  syncedAt                DateTime            @default(now())
  account                 WhatsAppAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  addressBookContact      AddressBookContact? @relation(fields: [addressBookContactId], references: [id], onDelete: SetNull)
  conversations           Conversation[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([accountId, jid])
  @@index([accountId, syncedAt])
  @@index([accountId, profilePictureUpdatedAt])
  @@index([addressBookContactId])
}

model AddressBookContact {
  id               String                   @id @default(cuid())
  accountId        String
  displayName      String
  lastName         String?
  email            String?
  company          String?
  tags             String?
  origin           AddressBookContactOrigin
  status           AddressBookContactStatus @default(VERIFIED)
  createdById      String?
  importId         String?
  firstSeenAt      DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  account          WhatsAppAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy        User?                    @relation("AddressBookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  import           ContactImport?           @relation("ImportedAddressBookContacts", fields: [importId], references: [id], onDelete: SetNull)
  phones           AddressBookPhone[]
  whatsappContacts Contact[]

  @@index([accountId, displayName])
  @@index([accountId, origin])
  @@index([accountId, status])
}

model AddressBookPhone {
  id                   String             @id @default(cuid())
  accountId            String
  addressBookContactId String
  normalizedPhone      String
  label                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  account              WhatsAppAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  addressBookContact   AddressBookContact @relation(fields: [addressBookContactId], references: [id], onDelete: Cascade)

  @@unique([accountId, normalizedPhone])
  @@index([accountId, normalizedPhone])
}

model ContactImport {
  id               String               @id @default(cuid())
  accountId        String
  createdById      String
  status           ContactImportStatus  @default(DRAFT)
  safeFileName     String
  fileHash         String
  totalRows        Int                  @default(0)
  validRows        Int                  @default(0)
  createdRows      Int                  @default(0)
  updatedRows      Int                  @default(0)
  skippedRows      Int                  @default(0)
  errorRows        Int                  @default(0)
  previewedAt      DateTime?
  appliedAt        DateTime?
  safeError        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  account          WhatsAppAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items            ContactImportItem[]
  importedContacts AddressBookContact[] @relation("ImportedAddressBookContacts")

  @@index([accountId, createdAt])
  @@index([createdById])
}

model ContactImportItem {
  id               String                  @id @default(cuid())
  importId         String
  rowNumber        Int
  proposedName     String?
  proposedLastName String?
  proposedEmail    String?
  proposedCompany  String?
  proposedTags     String?
  normalizedPhone  String?
  action           ContactImportItemAction
  safeError        String?
  createdAt        DateTime                @default(now())
  import           ContactImport           @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, action])
}

model Conversation {
  id                      String                         @id @default(cuid())
  accountId               String
  jid                     String
  type                    ConversationType
  contactId               String?
  lastMessageAt           DateTime?
  lastMessagePreview      String?
  unreadCount             Int                            @default(0)
  assignedToId            String?
  assignedAt              DateTime?
  account                 WhatsAppAccount                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact                 Contact?                       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo              User?                          @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages                Message[]
  outboundRequests        OutboundMessageRequest[]
  readReceiptRequests     ReadReceiptRequest[]
  historyRecoveryRequests HistoryRecoveryRequest[]
  notes                   ConversationNote[]
  tags                    ConversationTag[]
  externalIdentities      ConversationExternalIdentity[]
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  @@unique([accountId, jid])
  @@index([accountId, lastMessageAt])
  @@index([contactId])
  @@index([assignedToId])
}

/// Maps a transport-specific chat id to the stable domain conversation. Old
/// Historical bridge identifiers remain in Conversation.jid; browser ids are
/// attached here so historical threads are never duplicated during relinking.
model ConversationExternalIdentity {
  id              String             @id @default(cuid())
  accountId       String
  conversationId  String
  bridgeType      WhatsAppBridgeType
  externalChatId  String
  type            ConversationType
  normalizedPhone String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  account         WhatsAppAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation    Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([accountId, bridgeType, externalChatId])
  @@index([conversationId])
  @@index([accountId, normalizedPhone])
}

model Message {
  id                  String               @id @default(cuid())
  accountId           String
  externalId          String
  conversationId      String
  direction           MessageDirection
  senderJid           String
  receiptParticipant  String?
  body                String?
  messageType         String
  sentAt              DateTime
  importedAt          DateTime             @default(now())
  isRead              Boolean              @default(false)
  account             WhatsAppAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation        Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaAttachments    MediaAttachment[]
  readReceiptRequests ReadReceiptMessage[]

  @@unique([accountId, externalId])
  @@index([conversationId, sentAt])
  @@index([accountId, importedAt])
}

model ReadReceiptRequest {
  id             String               @id @default(cuid())
  accountId      String
  conversationId String
  requestedById  String
  status         ReadReceiptStatus    @default(PENDING)
  attemptCount   Int                  @default(0)
  lastAttemptAt  DateTime?
  safeError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sentAt         DateTime?
  account        WhatsAppAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy    User                 @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  messages       ReadReceiptMessage[]

  @@index([accountId, status, createdAt])
  @@index([conversationId])
}

model ReadReceiptMessage {
  requestId String
  messageId String             @unique
  request   ReadReceiptRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message   Message            @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([requestId, messageId])
}

model HistoryRecoveryRequest {
  id               String                @id @default(cuid())
  accountId        String
  conversationId   String
  requestedById    String
  fromAt           DateTime
  toAt             DateTime
  status           HistoryRecoveryStatus @default(PENDING)
  anchorExternalId String
  anchorSentAt     DateTime
  anchorFromMe     Boolean               @default(false)
  bridgeRequestId  String?                @map("baileysRequestId")
  pageCount        Int                   @default(0)
  receivedCount    Int                   @default(0)
  importedCount    Int                   @default(0)
  duplicateCount   Int                   @default(0)
  attemptCount     Int                   @default(0)
  lastAttemptAt    DateTime?
  safeError        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  completedAt      DateTime?
  account          WhatsAppAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation     Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy      User                  @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([accountId, status, createdAt])
  @@index([conversationId, createdAt])
  @@index([bridgeRequestId])
}

model MediaAttachment {
  id                       String                @id @default(cuid())
  accountId                String
  messageId                String
  position                 Int                   @default(0)
  kind                     MediaAttachmentKind
  status                   MediaAttachmentStatus @default(PENDING)
  mimeType                 String
  sizeBytes                Int?
  width                    Int?
  height                   Int?
  durationSeconds          Int?
  objectKey                String                @unique
  sha256                   String?
  storedAt                 DateTime?
  attemptCount             Int                   @default(0)
  lastAttemptAt            DateTime?
  safeError                String?
  sourceEnvelopeCiphertext String?
  sourceEnvelopeIv         String?
  sourceEnvelopeVersion    Int?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  account                  WhatsAppAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  message                  Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@index([accountId, status])
  @@index([messageId])
}

model OutboundMessageRequest {
  id             String                @id @default(cuid())
  accountId      String
  conversationId String
  requestedById  String
  body           String
  status         OutboundMessageStatus @default(PENDING)
  attemptCount   Int                   @default(0)
  lastAttemptAt  DateTime?
  safeError      String?
  externalId     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sentAt         DateTime?
  account        WhatsAppAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy    User                  @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@unique([accountId, externalId])
  @@index([accountId, status, createdAt])
  @@index([accountId, status, lastAttemptAt])
  @@index([conversationId])
}

model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

model ConversationTag {
  id            String          @id @default(cuid())
  accountId     String
  name          String
  color         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  account       WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([accountId, name])
  @@index([accountId])
}

model AuditLog {
  id        String           @id @default(cuid())
  userId    String?
  accountId String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  account   WhatsAppAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([accountId, createdAt])
}
